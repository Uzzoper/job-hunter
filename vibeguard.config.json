{
  "enabled": true,
  "patterns": {
    "keywords": [
      { "value": "application-local.yaml", "category": "LOCAL_CONFIG" }
    ],
    "regex": [
      { "pattern": "sk-or-v1-[A-Za-z0-9_-]{40,60}", "category": "OPENROUTER_KEY" },
      { "pattern": "(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,40}", "category": "GITHUB_TOKEN" },
      { "pattern": "(?i)(JWT_SECRET|OPENROUTER_API_KEY|HERMES_API_KEY)\\s*[=:]\\s*\\S+", "category": "ENV_SECRET" }
    ],
    "builtin": []
  }
}
